# Copy to .env and adjust. Never commit .env.

# "claude" (Anthropic API) or "ollama" (local, free)
LLM_PROVIDER=ollama

# Claude settings (only used when LLM_PROVIDER=claude).
# Set ANTHROPIC_API_KEY in your environment, or run `ant auth login`.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Ollama settings (only used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Retrieval defaults
RAG_CONFIG=heading__bge-small
TOP_K=4
